# -*- coding: utf-8 -*-
from typing import Any, Callable, Generic, List, Optional, Sequence, Type, TypeVar, Union, overload
from typing_extensions import deprecated as _deprecated

__all__ = ['MoreUI', 'CustomForm', 'BarForm', 'SidebarForm', 'Observable', 'ConfigMenu']

_T = TypeVar('_T', int, float, str, bool)
_Text = Union[str, 'Observable[str]']
_Number = Union[int, float, 'Observable[int]', 'Observable[float]']
_Index = Union[int, 'Observable[int]']
_Options = Optional[dict[str, Any]]


@_deprecated('【已废弃】新项目使用 FormUI.lib.Observable。')
class Observable(Generic[_T]):
    """【已废弃】MoreUI 数据绑定。"""

    def __init__(self, data: _T, options: _Options = ...) -> None: ...
    @staticmethod
    def create(data: _T, options: _Options = ...) -> Observable[_T]: ...
    @property
    def typeId(self) -> Type[_T]: ...
    def getData(self) -> _T: ...
    def setData(self, data: _T, bit: bool = ...) -> None: ...
    def subscribe(self, callback: Callable[[_T], None]) -> None: ...
    def unsubscribe(self, callback: Callable[[_T], None]) -> None: ...


class _FormLayout:
    """【已废弃】子表单的位置、跨度、偏移、边距和层级。"""

    position: Sequence[_Index]
    size: Sequence[_Index]
    offset: Sequence[_Number]
    margin: Sequence[_Number]
    layer: _Index


class _MoreUILayout:
    """【已废弃】MoreUI 容器的行列权重。"""

    row: Sequence[_Number]
    column: Sequence[_Number]


_FormT = TypeVar('_FormT', 'CustomForm', 'BarForm')


class _FormPlacement(Generic[_FormT]):
    """【已废弃】MoreUI 中的子表单及其布局。"""

    @property
    def form(self) -> _FormT: ...
    @property
    def layout(self) -> _FormLayout: ...
    @property
    def mayCloseAll(self) -> Observable[bool]: ...
    @mayCloseAll.setter
    def mayCloseAll(self, value: bool) -> None: ...


@_deprecated('【已废弃】此类用于兼容旧版 MoreUI。')
class MoreUI:
    """【已废弃】在同一个界面中显示多张旧版表单。"""

    def __init__(self, playerId: str, layout: _Options = ...) -> None: ...
    @staticmethod
    def create(playerId: str, layout: _Options = ...) -> MoreUI: ...
    @property
    def layout(self) -> _MoreUILayout: ...
    @layout.setter
    def layout(self, layout: Optional[dict[str, Sequence[_Number]]]) -> None: ...
    def addCustomForm(self, title: _Text, options: _Options = ...,
                      layout: _Options = ...) -> _FormPlacement[CustomForm]: ...
    def addBarForm(self, title: _Text, options: _Options = ...,
                   layout: _Options = ...) -> _FormPlacement[BarForm]: ...
    @overload
    def addForm(self, form: CustomForm, layout: _Options = ...) -> _FormPlacement[CustomForm]: ...
    @overload
    def addForm(self, form: BarForm, layout: _Options = ...) -> _FormPlacement[BarForm]: ...
    def removeForm(self, form: Union[_FormPlacement[CustomForm], _FormPlacement[BarForm],
                                     CustomForm, BarForm]) -> MoreUI: ...
    def show(self) -> None: ...
    def close(self) -> MoreUI: ...



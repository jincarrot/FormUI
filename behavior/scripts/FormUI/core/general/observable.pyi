# -*- coding: utf-8 -*-
from typing import Any, Callable, Generic, TypeVar

_T = TypeVar("_T")
ObId: int

class Observable(Generic[_T]):
    """运算生成派生 Observable；subscribe 的参数是本次的新值。"""
    identifier: str
    def __init__(self, value: _T) -> None: ...
    @property
    def _id(self) -> int: ...
    def getData(self) -> _T: ...
    def setData(self, v: _T) -> None: ...
    def getValue(self) -> _T: ...
    def setValue(self, v: _T) -> None: ...
    def _onUpdate(self, v: _T) -> None: ...
    def subscribe(self, callback: Callable[[_T], None]) -> None: ...
    def unsubscribe(self, callback: Callable[[_T], None]) -> None: ...
    def __bool__(self) -> bool: ...
    def __nonzero__(self) -> bool: ...
    def __lt__(self, value: Any) -> Observable[bool]: ...
    def __le__(self, value: Any) -> Observable[bool]: ...
    def __gt__(self, value: Any) -> Observable[bool]: ...
    def __ge__(self, value: Any) -> Observable[bool]: ...
    def __eq__(self, value: object) -> Observable[bool]: ...  # type: ignore[override]
    def __ne__(self, value: object) -> Observable[bool]: ...  # type: ignore[override]
    def __add__(self, value: Any) -> Observable[Any]: ...
    def __radd__(self, value: Any) -> Observable[Any]: ...
    def __sub__(self, value: Any) -> Observable[Any]: ...
    def __rsub__(self, value: Any) -> Observable[Any]: ...
    def __mul__(self, value: Any) -> Observable[Any]: ...
    def __rmul__(self, value: Any) -> Observable[Any]: ...
    def __truediv__(self, value: Any) -> Observable[Any]: ...
    def __rtruediv__(self, value: Any) -> Observable[Any]: ...
    def __div__(self, value: Any) -> Observable[Any]: ...
    def __rdiv__(self, value: Any) -> Observable[Any]: ...
    def __floordiv__(self, value: Any) -> Observable[Any]: ...
    def __rfloordiv__(self, value: Any) -> Observable[Any]: ...
    def __mod__(self, value: Any) -> Observable[Any]: ...
    def __rmod__(self, value: Any) -> Observable[Any]: ...
    def __and__(self, value: Any) -> Observable[Any]: ...
    def __rand__(self, value: Any) -> Observable[Any]: ...
    def __or__(self, value: Any) -> Observable[Any]: ...
    def __ror__(self, value: Any) -> Observable[Any]: ...
    def __xor__(self, value: Any) -> Observable[Any]: ...
    def __rxor__(self, value: Any) -> Observable[Any]: ...
    def __lshift__(self, value: Any) -> Observable[Any]: ...
    def __rlshift__(self, value: Any) -> Observable[Any]: ...
    def __rshift__(self, value: Any) -> Observable[Any]: ...
    def __rrshift__(self, value: Any) -> Observable[Any]: ...
    def __pow__(self, value: Any, mod: Any = None) -> Observable[Any]: ...
    def __rpow__(self, value: Any, mod: Any = None) -> Observable[Any]: ...

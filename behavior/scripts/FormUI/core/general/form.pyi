# -*- coding: utf-8 -*-
from typing import Any, Callable, Iterable
from .interfaces.controls import (
    BoolValue, ButtonHandler, ControlStyle, DropdownItem, GroupChildren,
    GroupStyle, NumberValue, TextValue, ListViewItems, ListViewValue, ListViewStyle,
)
from .interfaces.form import FormStyle, FormTheme
from .interfaces.grid import GridPosition, FormLayout
from .observable import Observable
from ..utils.type import FormShowResultArgs

class FormShowResult:
    def __init__(self, formId: int, targets: Iterable[str]) -> None: ...
    def onClose(self, callback: Callable[[FormShowResultArgs], None] | None) -> None:
        """每个目标玩家关闭时触发一次；返回 None。"""
        ...

class Form:
    identifier: str
    def __init__(self, id: int, title: TextValue = "", style: FormStyle | None = None,
                 theme: FormTheme | None = None, grid: GridPosition | None = None,
                 layout: FormLayout | None = None, root: str | None = None) -> None: ...
    @property
    def formId(self) -> int: ...
    def getShowingPlayers(self) -> list[str]: ...
    def isAnyShowing(self) -> bool: ...
    def isShowing(self, playerId: str | None = None) -> bool:
        """服务端省略参数时检查历史显示过的全部玩家；客户端默认查询本地玩家。"""
        ...
    def button(self, label: TextValue, callbacks: ButtonHandler | None = ..., style: ControlStyle = ..., params: dict[str, Any] = ..., grid: GridPosition | None = None) -> Form: ...
    def toggle(self, label: TextValue, state: BoolValue, style: ControlStyle = ..., params: dict[str, Any] = ..., grid: GridPosition | None = None) -> Form: ...
    def divider(self, style: ControlStyle = ..., params: dict[str, Any] = ..., grid: GridPosition | None = None) -> Form: ...
    def label(self, text: TextValue, style: ControlStyle = ..., params: dict[str, Any] = ..., grid: GridPosition | None = None) -> Form:
        """fontSize 为字体缩放倍数，可绑定 Observable 或使用 default。"""
        ...
    def slider(self, label: TextValue, value: NumberValue, minValue: NumberValue = 0.0, maxValue: NumberValue = 1.0, step: NumberValue = 1, style: ControlStyle = ..., params: dict[str, Any] = ..., grid: GridPosition | None = None) -> Form:
        """step=0 为连续模式；负步长取绝对值，反向边界自动排序。"""
        ...
    def textfield(self, label: TextValue, value: TextValue, style: ControlStyle = ..., params: dict[str, Any] = ..., grid: GridPosition | None = None) -> Form: ...
    def dropdown(self, label: TextValue, items: list[DropdownItem], value: int | str | Observable[int] | Observable[str], style: ControlStyle = ..., params: dict[str, Any] = ..., grid: GridPosition | None = None) -> Form:
        """items 为静态选项；菜单标题与选中值可绑定 Observable。"""
        ...
    def listview(self, label: TextValue, items: ListViewItems, value: ListViewValue = None, style: ListViewStyle = ..., params: dict[str, Any] = ..., grid: GridPosition | None = None) -> Form:
        """内部滚动的单选列表；订阅 value 获取选择，items 可整体替换，返回自身。"""
        ...
    def group(self, children: GroupChildren = ..., style: GroupStyle = ..., params: dict[str, Any] = ..., grid: GridPosition | None = None) -> Form:
        """添加组实例；子控件数据按名称提供，百分比布局相对父组计算。"""
        ...
    def custom(self, params: dict[str, Any] = ..., style: ControlStyle = ..., grid: GridPosition | None = None) -> Form: ...
    def bindTemplate(self, name: str | None = None) -> Form: ...
    def toJsonUI(self, name: str) -> dict[str, Any]: ...
    def show(self, target: str | Iterable[str] | None = None, onClose: Callable[[FormShowResultArgs], None] | None = None) -> FormShowResult: ...
    def close(self, target: str | Iterable[str] | None = None) -> None:
        """关闭目标玩家的表单；返回 None。"""
        ...

# -*- coding: utf-8 -*-
from typing import Any
from mod.client.ui.controls.baseUIControl import BaseUIControl
from ..client.ui.screen import Screen

class CreateArguments:
    def __init__(self, screenNode: Screen, control: BaseUIControl, params: dict[str, Any] | None = None, style: dict[str, Any] | None = None) -> None: ...
    @property
    def screenNode(self) -> Screen: ...
    @property
    def control(self) -> BaseUIControl: ...
    @property
    def params(self) -> dict[str, Any]: ...
    @property
    def style(self) -> dict[str, Any]:
        """布局完成时的实例样式快照，Observable 已解包；修改快照不会改变控件。"""
        ...

class FormShowResultArgs:
    def __init__(self, data: dict[str, Any]) -> None: ...
    @property
    def closeReason(self) -> str: ...
    @property
    def playerId(self) -> str: ...

class ObservableUpdateArguments:
    def __init__(self, old: Any, new: Any, key: str, screenNode: Screen | None = None, control: BaseUIControl | None = None, params: dict[str, Any] | None = None) -> None: ...
    @property
    def oldValue(self) -> Any: ...
    @property
    def newValue(self) -> Any: ...
    @property
    def key(self) -> str: ...
    @property
    def screenNode(self) -> Screen | None: ...
    @property
    def control(self) -> BaseUIControl | None: ...
    @property
    def params(self) -> dict[str, Any]: ...

def unwrapWrappedValue(data: Any, previous: dict[int, Any] | None = None) -> Any: ...
def updateWrappedObservable(data: Any, obId: int, value: Any) -> dict[int, Any]: ...
def getCustomObservableUpdates(form: dict[str, Any], previous: dict[int, Any], value: Any) -> list[tuple[int | tuple[int | str, ...], str, Any, Any]]: ...
def wrapVariable(value: Any, record: list[int] = ...) -> dict[str, Any]: ...
def wrapDict(value: dict[str, Any], record: list[int] = ...) -> dict[str, Any]: ...
def wrapList(value: list[Any], record: list[int] = ...) -> list[Any]: ...

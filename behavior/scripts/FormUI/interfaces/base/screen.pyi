# -*- coding: utf-8 -*-
from typing import Any, Iterable
from ...core.general.interfaces.controls import ControlKind, ControlStyle, GroupStyle, ListViewStyle
from ...core.general.interfaces.form import FormStyle
from ...core.general.interfaces.grid import GridTracks, GridLayout

class Screen:
    @staticmethod
    def setGrid(columns: GridTracks = 1, rows: GridTracks = 1, gap: int | float = 0, padding: int | float = 0) -> None: ...
    @staticmethod
    def getGrid() -> GridLayout | None: ...
    @staticmethod
    def clearGrid() -> None: ...
    @staticmethod
    def setDefaultTheme(name: str | None = None) -> None: ...
    @staticmethod
    def getDefaultTheme() -> str | None: ...
    @staticmethod
    def setDefaultStyle(controlType: ControlKind, style: ControlStyle | GroupStyle | FormStyle | ListViewStyle) -> None: ...
    @staticmethod
    def getDefaultStyle(controlType: ControlKind) -> dict[str, Any]: ...
    @staticmethod
    def closeAllForms(target: str | Iterable[str] | None = None) -> None: ...

{
    "w": {
        "type": "image",
        "anchor_from": "center",
        "anchor_to": "center",
        "offset": [
            0.0,
            0.0
        ],
        "size": [
            "100%",
            "100%"
        ],
        "layer": 0,
        "alpha": 1.0,
        "fill": true,
        "rotate_pivot": [
            0.5,
            0.5
        ],
        "texture": "textures/ui/white_bg"
    },
    "blank@w": {
        "alpha": 0.0
    },
    "screen": {
        "type": "screen",
        "controls": [
            {
                "panel": {
                    "type": "panel",
                    "anchor_from": "top_left",
                    "anchor_to": "top_left",
                    "size": [
                        "100%",
                        "100%"
                    ]
                }
            },
            {
                "pre_screen": {
                    "type": "panel",
                    "controls": [
                        {
                            "progress@progress.progress_loading_bars": {
                                "size": [
                                    30,
                                    4
                                ],
                                "bindings": [
                                    {
                                        "binding_type": "view",
                                        "source_control_name": "image",
                                        "resolve_sibling_scope": true,
                                        "source_property_name": "(#texture = 'loading')",
                                        "target_property_name": "#visible"
                                    }
                                ]
                            }
                        }
                    ]
                }
            }
        ]
    },
    "namespace": "fui"
}
{
    "embedded_root": {
        "type": "input_panel",
        "is_swallow": true,
        "anchor_from": "top_left",
        "anchor_to": "top_left",
        "size": ["100%", "100%"]
    },
    "panel": {
        "type": "input_panel",
        "is_swallow": true,
        "anchor_from": "center",
        "anchor_to": "center",
        "size": ["100%", "100%"]
    },
    "group": {
        "type": "input_panel",
        "is_swallow": true,
        "anchor_from": "top_left",
        "anchor_to": "top_left",
        "size": ["100%", 32]
    },
    "w": {
        "type": "image",
        "anchor_from": "center",
        "anchor_to": "center",
        "offset": [
            0.0,
            0.0
        ],
        "size": [
            "100%",
            "100%"
        ],
        "layer": 0,
        "alpha": 1.0,
        "fill": true,
        "rotate_pivot": [
            0.5,
            0.5
        ],
        "texture": "textures/ui/white_bg"
    },
    "blank@w": {
        "alpha": 0.0
    },
    "screen": {
        "type": "screen",
        "controls": [
            {
                "panel": {
                    "type": "input_panel",
                    "is_swallow": true,
                    "anchor_from": "top_left",
                    "anchor_to": "top_left",
                    "size": [
                        "100%",
                        "100%"
                    ]
                }
            },
            {
                "pre_screen": {
                    "type": "input_panel",
                    "is_swallow": true,
                    "controls": [
                        {
                            "progress@progress.progress_loading_bars": {
                                "size": [
                                    30,
                                    4
                                ],
                                "bindings": []
                            }
                        }
                    ]
                }
            }
        ]
    },
    "namespace": "fui"
}

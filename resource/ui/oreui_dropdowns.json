                        },
                        {
                            "shadow@fui.w": {
                                "anchor_from": "bottom_middle",
                                "anchor_to": "bottom_middle",
                                "color": "$shadow_color",
                                "layer": 1,
                                "offset": [
                                    0,
                                    -1
                                ],
                                "size": [
                                    "100% - 2px",
                                    "2px"
                                ]
                            }
                        },
                        {
                            "label": {
                                "type": "label",
                                "anchor_from": "$label_anchor",
                                "anchor_to": "$label_anchor",
                                "offset": [
                                    4,
                                    -1
                                ],
                                "max_size": [
                                    "100%",
                                    "100%"
                                ],
                                "layer": 3,
                                "color": "$label_color",
                                "font_scale_factor": "$label_font_scale_factor",
                                "font_size": "$label_font_size",
                                "font_type": "smooth",
                                "text": "$label_text"
                            }
                        },
                        {
                            "arrow": {
                                "type": "image",
                                "anchor_from": "right_middle",
                                "anchor_to": "bottom_right",
                                "offset": [
                                    -8,
                                    2
                                ],
                                "size": [
                                    8,
                                    8
                                ],
                                "layer": 4,
                                "rotate_angle": -90,
                                "texture": "textures/ui/arrow_r_default"

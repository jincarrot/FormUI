{
    "dropdown": {
        "type": "panel",
        "anchor_from": "top_left",
        "anchor_to": "top_left",
        "size": [
            "100%",
            "45px"
        ],
        "controls": [
            {
                "label": {
                    "type": "label",
                    "anchor_from": "top_left",
                    "anchor_to": "top_left",
                    "offset": [
                        0.0,
                        2.0
                    ],
                    "font_scale_factor": 1.25,
                    "font_type": "smooth",
                    "text": "Label"
                }
            },
            {
                "dropdown_box@dropdown_box": {
                    "$label_anchor": "left_middle",
                    "$label_offset_x": 2,
                    "anchor_from": "bottom_middle",
                    "anchor_to": "bottom_middle",
                    "layer": 1,
                    "size": [
                        "100%",
                        "100%+-15px"
                    ]
                }
            },
            {
                "content_panel": {
                    "type": "panel",
                    "anchor_from": "top_middle",
                    "anchor_to": "top_middle",
                    "offset": [
                        0.0,
                        15.0
                    ],
                    "size": [
                        "100%",
                        "100%+-15px"
                    ],
                    "layer": 6,
                    "visible": false,
                    "controls": [
                        {
                            "border@fui.w": {
                                "color": [
                                    0,
                                    0,
                                    0
                                ]
                            }
                        },
                        {
                            "bg@fui.w": {
                                "color": [
                                    0.549,
                                    0.5529,
                                    0.5647
                                ],
                                "size": [
                                    "100%-2px",
                                    "100%-2px"
                                ]
                            }
                        }
                    ]
                }
            }
        ]
    },
    "dropdown_box@common.button": {
        "type": "button",
        "$base_color_default": [
            0.82,
            0.82,
            0.83
        ],
        "$base_color_hover": [
            0.69,
            0.7,
            0.71
        ],
        "$border_alpha_br_default": 0.9,
        "$border_alpha_br_hover": 0.9,
        "$border_alpha_tl_default": 0.7,
        "$border_alpha_tl_hover": 0.7,

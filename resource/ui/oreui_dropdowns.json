            },
            {
                "pressed": {
                    "type": "panel",
                    "controls": [
                        {
                            "border@fui_ore_base.border": {
                                "layer": 0,
                                "offset": [
                                    0,
                                    1
                                ],
                                "size": [
                                    "100%",
                                    "100% - 2px"
                                ]
                            }
                        },
                        {
                            "background@fui_ore_base.base_thin": {
                                "$bg_color": "$base_color_hover",
                                "$shadow_alpha_b_r": "$border_alpha_br_hover",
                                "$shadow_alpha_t_l": "$border_alpha_tl_hover",
                                "anchor_from": "bottom_middle",
                                "anchor_to": "bottom_middle",
                                "layer": 1,
                                "size": [
                                    "100%",
                                    "100% - 2px"
                                ]
                            }
                        },
                        {
                            "label": {
                                "type": "label",
                                "anchor_from": "$label_anchor",
                                "anchor_to": "$label_anchor",
                                "offset": [
                                    4,
                                    1
                                ],
                                "max_size": [
                                    "100%",
                                    "100%"
                                ],
                                "layer": 3,
                                "color": "$label_color",
                                "font_scale_factor": "$label_font_scale_factor",
                                "font_size": "$label_font_size",
                                "font_type": "smooth",
                                "text": "$label_text"
                            }
                        }
                    ]
                }
            }
        ]
